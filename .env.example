# ==========================================
# DeployGuard AI - Environment Configuration
# ==========================================

# Port (default 3000)
PORT=3000

# MongoDB Connection String (Optional)
# If omitted or if MongoDB is unreachable, DeployGuard AI automatically
# falls back to its built-in in-memory storage engine with zero setup.
MONGODB_URI=mongodb://localhost:27017/deployguard_ai

# Optional Google Gemini AI API Key
# If omitted, DeployGuard's deterministic offline rule engine handles 100%
# of log triage, root cause detection, and remediation steps.
GEMINI_API_KEY=
